{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cat-multiplication-park",
	"main": "server/worker.mjs",
	"compatibility_date": "2026-09-26",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/auth/*"
		]
	},
	"vars": {
		"APP_ENV": "production",
		"PUBLIC_ORIGIN": "https://cat-multiplication-park.qing-idea.workers.dev"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "cat-game",
			"database_id": "09db4d94-c9cc-4c13-a460-83fd7d62b211",
			"preview_database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	]
}
